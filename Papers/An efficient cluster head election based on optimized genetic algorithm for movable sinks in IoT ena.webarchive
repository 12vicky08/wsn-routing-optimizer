          config: {"adobeSuite":"elsevier-sd-prod","aiNavigation":{"enabled":true,"version":"V1"},"arsUrl":"https://ars.els-cdn.com","assetRoute":"/eu-west-1/prod/bd96d51d266808527bf1018bd38b59c0b4bc6286","recommendationsFeedback":{"enabled":true,"url":"https://feedback.recs.d.elsevier.com/raw/events","timeout":60000},"googleMapsApiKey":"REDACTED_API_KEY","mediaBaseUrl":"https://ars.els-cdn.com/content/image/","xocsMediaPlayerBaseUrl":"/shared-assets/147/js/ableplayer","strictMode":false,"scienceDirectUrl":"https://www.sciencedirect.com","seamlessAccess":{"enableSeamlessAccess":true,"scriptUrl":"https://unpkg.com/@theidentityselector/thiss-ds@1.0.13/dist/thiss-ds.js","persistenceUrl":"https://service.seamlessaccess.org/ps/","persistenceContext":"seamlessaccess.org","shibAuthUrl":"https://auth.elsevier.com/ShibAuth/institutionLogin"},"reaxys":{"apiUrl":"https://reaxys-sdlc.reaxys.com","origin":"sciencedirect","queryBuilderHostPath":"https://www.reaxys.com/reaxys/secured/hopinto.do","url":"https://www.reaxys.com"},"oneTrustCookie":{"enabled":true},"shadowBackend":{"abstract":false,"citedBy":false,"glossary":false},"ssrn":{"url":"https://papers.ssrn.com","path":"/sol3/papers.cfm"},"newUi":true,"enableOptOut":false},
