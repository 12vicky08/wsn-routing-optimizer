ht{padding-right:16px}}.pull-left{float:left}.pull-right{float:right}.sr-only{border:0;clip:rect(0 0 0 0);height:1px;margin:-1px;overflow:hidden;padding:0;position:absolute;width:1px}.sr-only-focusable:active,.sr-only-focusable:focus{clip:auto;height:auto;margin:0;overflow:visible;position:static}.text-content{font-size:16px}.u-clamp-2-lines{overflow:hidden;display:-webkit-box;-webkit-box-align:start;-webkit-box-orient:vertical;-webkit-line-clamp:2}.pagination{text-align:center}.pagination .underline-page-number{border-bottom:2px solid #ff6c00}.pagination .pagination-current{font-weight:bold}.pagination .previous-button{margin-left:-80px}@media all and (-ms-high-contrast: none),(-ms-high-contrast: active){.pagination .previous-button{margin-left:265px}}.pagination-pages-label{color:#1f1f1f;margin-right:8px}html,body{margin:0;padding:0;height:100%;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}.glyph,.inline-figure>img{vertical-align:middle}.u-margin-xxs-bottom{margin-bottom:4px}.u-word-break-break-all{word-break:break-all}.u-valign-middle{vertical-align:middle}.u-bg-ai-purple{background-color:#d8b8ff}.u-truncate-anchor-text{max-width:100%;display:-webkit-inline-box;display:-ms-inline-flexbox;display:inline-flex}.u-truncate-anchor-text .anchor-text-container{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.anchor .icon{-ms-flex-negative:0;flex-shrink:0}#gh-cnt{z-index:3}
